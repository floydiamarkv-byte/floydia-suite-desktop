# ==============================================================================
# FLOYDIA SUITE (F-SUITE) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your personal API keys and endpoints:
#   cp .env.example .env
#
# P0 Security Note: Never commit your actual .env file to version control.
# ==============================================================================

# ── Primary Providers (AI Studio, OpenRouter, DeepSeek, NVIDIA, Mistral) ─────
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
C1_GOOGLE_AISTUDIO=your_google_ai_studio_api_key_here
C2_GOOGLE_AISTUDIO=

OPENROUTER_API_KEY=your_openrouter_api_key_here
C7_OPENROUTER=
C7_OPENROUTER_OPENCODE_HP15=

DEEPSEEK_API_KEY=your_deepseek_api_key_here
C1_DEEPSEEK=
C7_DEEPSEEK=

NVIDIA_API_KEY=your_nvidia_nim_api_key_here
C7_NVIDIA=
C1_NVIDIA=

MISTRAL_API_KEY=your_mistral_api_key_here
C1_MISTRAL=

# ── Optional Secondary Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=

# ── Optional Homelab & Agent Sync Overrides ──────────────────────────────────
# OPENCODE_CONFIG_PATH=~/.config/opencode/opencode.jsonc
# HERMES_CONFIG_PATH=~/.hermes/config.yaml
# ZED_CONFIG_PATH=~/.config/zed/settings.json
# MCP_CONFIG_PATH=~/.gemini/config/mcp_config.json
